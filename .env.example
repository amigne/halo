# Halo — environment variables for PRODUCTION (T-152)
#
# Copy this file to .env and adjust values for your deployment.
#   cp .env.example .env
#
# The .env file is NEVER committed (see .gitignore).
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(64))"

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres 18 (required for production, T-154)
DATABASE_URL=postgresql+psycopg://postgres:change-me@db:5432/halo

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-with-secrets-token-urlsafe-64

# ── Argon2id (T-080) ─────────────────────────────────────────────────────────
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4

# ── Sessions (T-070) ─────────────────────────────────────────────────────────
SESSION_TTL_MINUTES=1440
SESSION_COOKIE_NAME=halo_session
SESSION_SECURE_COOKIE=true

# ── Tokens (T-081/T-082) ─────────────────────────────────────────────────────
TOKEN_TTL_MINUTES=60

# ── SMTP ─────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@halo.example.com
SMTP_USE_TLS=true

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://halo.example.com

# ── App URL (for email links) ────────────────────────────────────────────────
APP_URL=https://halo.example.com

# ── Rate limiting (T-086) ────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_RESET_PER_HOUR=3

# Comma-separated IPs of trusted reverse proxies (e.g. Caddy, Nginx).
# When set, X-Forwarded-For is honoured for rate-limit client identification.
TRUSTED_PROXIES=
