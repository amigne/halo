# Halo — environment variables for DEVELOPMENT (T-152)
#
# Copy this file to .env.dev and adjust values for your local setup.
#   cp .env.dev.example .env.dev
#
# The .env.dev file is NEVER committed (see .gitignore).

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# Default: SQLite (file stored in the halo_dev_data volume)
DATABASE_URL=sqlite+aiosqlite:///./data/halo.db

# To switch to Postgres 18, start the db service profile and use:
#   docker compose -f docker-compose.dev.yml --profile postgres up -d
# DATABASE_URL=postgresql+psycopg://postgres:halotest@db:5432/halodev

# Test database URL (used by pytest when Postgres is available)
# TEST_PG_URL=postgresql+psycopg://postgres:halotest@localhost:5432/halotest

# ── Redis ────────────────────────────────────────────────────────────────────
# Inside Docker Compose, the Redis hostname is "redis"
REDIS_URL=redis://redis:6379/0

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=dev-secret-key-not-for-production

# ── Argon2id (T-080) ─────────────────────────────────────────────────────────
# Low cost for fast local dev
ARGON2_TIME_COST=2
ARGON2_MEMORY_COST=32768
ARGON2_PARALLELISM=2

# ── Sessions (T-070) ─────────────────────────────────────────────────────────
SESSION_TTL_MINUTES=1440
SESSION_COOKIE_NAME=halo_session
SESSION_SECURE_COOKIE=false

# ── Tokens (T-081/T-082) ─────────────────────────────────────────────────────
TOKEN_TTL_MINUTES=60

# ── SMTP / Mailpit ───────────────────────────────────────────────────────────
# Mailpit catches all outbound mail — no real emails sent in dev.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@halo.local
SMTP_USE_TLS=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origins for CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App URL (for email links) ────────────────────────────────────────────────
APP_URL=http://localhost:5173

# ── Rate limiting (T-086) ────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_HOUR=3
RATE_LIMIT_RESET_PER_HOUR=3

# Comma-separated IPs of trusted reverse proxies.
# Leave empty in dev (no proxy between browser and backend).
TRUSTED_PROXIES=
